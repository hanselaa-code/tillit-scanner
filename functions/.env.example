# SCANSAFE / TILLIT BACKEND CONFIGURATION
# Kopier denne filen til .env og fyll inn dine egne nøkler

# Google Gemini API Key (fra Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Valgfritt: Google Cloud Project ID hvis du deployer til Vertex AI
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Valgfritt: Egendefinert port for lokal kjøring
PORT=5001
